# =============================================================================
# Roast Room — Environment Configuration Example
# =============================================================================

# AI Provider: "gemini" (default) or "anthropic"
AI_PROVIDER=gemini

# Google Gemini API keys (supports 1 or more keys with auto-rotation & failover):
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Anthropic API key (optional): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# "viewer" (default) or "api"
COUNCIL_RUNNER=api

# Default models
SEAT_MODEL=gemini-2.5-flash
CHAIR_MODEL=gemini-2.5-pro

# Used by /newroaster to make a new advisor's cartoon portrait
KIE_AI_API_KEY=
